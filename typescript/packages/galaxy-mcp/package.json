  },
  "dependencies": {
    "@galaxyproject/galaxy-ops": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^8.3.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4",
    "typescript": "^7.0.2"
  }
}
