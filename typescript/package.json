{
  "name": "galaxy-mcp-typescript",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19" },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "depcruise": "dependency-cruiser --config .dependency-cruiser.cjs packages/galaxy-ops/src/index.ts packages/galaxy-mcp/src/index.ts packages/galaxy-cli/src/index.ts",
    "parity:report": "pnpm --filter @galaxyproject/galaxy-mcp parity:report",
    "parity:report:print": "pnpm --silent --filter @galaxyproject/galaxy-mcp parity:report:print"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "dependency-cruiser": "^18.7.0"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "vite": "~8.1.6"
    }
  }
}
